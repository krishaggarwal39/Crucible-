# ─── Application ──────────────────────────────────────────────────────────────
# "development" (default) disables SSRF protection so you can evaluate a target
# agent on localhost, and leaves the Secure cookie flag off for plain HTTP.
# Anything else (e.g. "production") enables both.
APP_ENV=development

# Number of trusted reverse proxies in front of the app.
# 0 = never trust X-Forwarded-For (correct when exposed directly).
# 1 = one trusted proxy, e.g. the nginx in docker-compose.prod.yml.
# Required for correct per-client rate limiting behind a proxy.
TRUSTED_PROXY_COUNT=0

# Origins allowed to call the API with credentials.
# Accepts a comma-separated list or a JSON array. Leave blank for local dev.
ALLOW_ORIGINS=

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=crucible
POSTGRES_PASSWORD=crucible_secret
POSTGRES_DB=crucible
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# DATABASE_URL is auto-assembled by config.py from the fields above. Do NOT set it here.
# The test suite uses <POSTGRES_DB>_test and creates it automatically.

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL / CELERY_* / REDIS_PUBSUB_URL are auto-assembled. Do NOT set them here.

# ─── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=behavioral_traces

# ─── Object storage (MinIO / S3) ──────────────────────────────────────────────
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD configure the MinIO *server* in
# docker-compose. S3_ACCESS_KEY / S3_SECRET_KEY are what the application uses.
# Keep them in sync — compose derives the app values from the root credentials.
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin_secret

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin_secret
S3_BUCKET_TRACES=crucible-traces
S3_REGION=us-east-1
S3_USE_SSL=false

# ─── AI Providers ─────────────────────────────────────────────────────────────
# REQUIRED. Serves the judge, generator and evolution models. The defaults are
# NVIDIA Nemotron free-tier models hosted on OpenRouter, so this is the only
# provider key the pipeline needs to run.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OPTIONAL — only used for drift analysis (embeddings).
# OpenRouter has no embeddings endpoint, so drift needs a separate provider.
# Without this key everything else still works and drift is reported as
# "embeddings_disabled" rather than failing.
GEMINI_API_KEY=

# Not used by the default configuration. Leave blank unless you point
# DEFAULT_JUDGE_MODEL / DEFAULT_GENERATOR_MODEL / DEFAULT_EMBEDDING_MODEL at them.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
VOYAGE_API_KEY=

# ─── LLM defaults ─────────────────────────────────────────────────────────────
# Chat models. These must produce valid structured output under Instructor's
# TOOLS mode, which the judge/generator/evolution nodes depend on.
# Verified working: nemotron-3-super-120b-a12b, nemotron-3-nano-30b-a3b,
# nemotron-nano-9b-v2 — all ":free" on OpenRouter.
# Known bad: openrouter/openai/gpt-oss-20b:free returns a provider error under
# TOOLS mode, so keep it out of FALLBACK_MODELS.
# DEFAULT_JUDGE_MODEL=openrouter/nvidia/nemotron-3-super-120b-a12b:free
# DEFAULT_GENERATOR_MODEL=openrouter/nvidia/nemotron-3-super-120b-a12b:free
# FALLBACK_MODELS accepts a comma-separated list.
# FALLBACK_MODELS=openrouter/nvidia/nemotron-3-nano-30b-a3b:free,openrouter/nvidia/nemotron-nano-9b-v2:free

# Embeddings. Must be a real embedding model — never an openrouter/... value
# (startup will reject it). EMBEDDING_DIMENSIONS is requested explicitly, so it
# also controls the Qdrant collection width. gemini-embedding-001 returns 3072
# natively but supports reduction to 768 or 1536.
# Set DEFAULT_EMBEDDING_MODEL empty to switch drift analysis off entirely.
# DEFAULT_EMBEDDING_MODEL=gemini/gemini-embedding-001
# EMBEDDING_DIMENSIONS=768

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
# Must be changed for any non-development use; startup fails if the placeholder
# below is still set while APP_ENV is not development.
JWT_SECRET_KEY=super_secret_jwt_key_change_in_production
JWT_ALGORITHM=HS256

# ─── Credential encryption ────────────────────────────────────────────────────
# Must be a valid Fernet key. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# An invalid key is now rejected at startup rather than silently transformed into
# a different working key (which would make stored credentials undecryptable).
CREDENTIAL_ENCRYPTION_KEY=your_fernet_key_here

# ─── Observability ────────────────────────────────────────────────────────────
# Off by default; the console exporters are noisy in local development.
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
