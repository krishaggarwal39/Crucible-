# Database
POSTGRES_USER=crucible
POSTGRES_PASSWORD=crucible_secret
POSTGRES_DB=crucible
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# DATABASE_URL is auto-assembled by config.py from above fields. Do NOT set it here.

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL is auto-assembled by config.py from above fields. Do NOT set it here.

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# MinIO
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin_secret
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin_secret

# AI Providers
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# JWT Auth
JWT_SECRET_KEY=super_secret_jwt_key_change_in_production
JWT_ALGORITHM=HS256
