# ─── Application ──────────────────────────────────────────────────────────────
# "development" (default) disables SSRF protection so you can evaluate a target
# agent on localhost, and leaves the Secure cookie flag off for plain HTTP.
# Anything else (e.g. "production") enables both.
APP_ENV=development

# Number of trusted reverse proxies in front of the app.
# 0 = never trust X-Forwarded-For (correct when exposed directly).
# 1 = one trusted proxy, e.g. the nginx in docker-compose.prod.yml.
# Required for correct per-client rate limiting behind a proxy.
TRUSTED_PROXY_COUNT=0

# Origins allowed to call the API with credentials.
# Accepts a comma-separated list or a JSON array. Leave blank for local dev.
ALLOW_ORIGINS=

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=crucible
POSTGRES_PASSWORD=crucible_secret
POSTGRES_DB=crucible
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# DATABASE_URL is auto-assembled by config.py from the fields above. Do NOT set it here.
# The test suite uses <POSTGRES_DB>_test and creates it automatically.

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL / CELERY_* / REDIS_PUBSUB_URL are auto-assembled. Do NOT set them here.

# ─── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=behavioral_traces

# ─── Object storage (MinIO / S3) ──────────────────────────────────────────────
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD configure the MinIO *server* in
# docker-compose. S3_ACCESS_KEY / S3_SECRET_KEY are what the application uses.
# Keep them in sync — compose derives the app values from the root credentials.
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin_secret

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin_secret
S3_BUCKET_TRACES=crucible-traces
S3_REGION=us-east-1
S3_USE_SSL=false

# ─── AI Providers ─────────────────────────────────────────────────────────────
# OPENROUTER_API_KEY powers the default judge/generator models.
# GEMINI_API_KEY powers the default embedding model used for drift analysis.
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# ─── LLM defaults ─────────────────────────────────────────────────────────────
# DEFAULT_EMBEDDING_MODEL must be a real *embedding* model, and
# EMBEDDING_DIMENSIONS must match its output size or drift analysis will reject
# every vector. gemini/text-embedding-004 emits 768 dimensions.
# DEFAULT_EMBEDDING_MODEL=gemini/text-embedding-004
# EMBEDDING_DIMENSIONS=768
# FALLBACK_MODELS accepts a comma-separated list.

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
# Must be changed for any non-development use; startup fails if the placeholder
# below is still set while APP_ENV is not development.
JWT_SECRET_KEY=super_secret_jwt_key_change_in_production
JWT_ALGORITHM=HS256

# ─── Credential encryption ────────────────────────────────────────────────────
# Must be a valid Fernet key. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# An invalid key is now rejected at startup rather than silently transformed into
# a different working key (which would make stored credentials undecryptable).
CREDENTIAL_ENCRYPTION_KEY=your_fernet_key_here

# ─── Observability ────────────────────────────────────────────────────────────
# Off by default; the console exporters are noisy in local development.
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
